# Container Deployment Configuration
# This is a template - copy to .config (global) or targets/{target}/.config (per-target)

# ============================================================================
# ENGINE SELECTION
# ============================================================================
# Container engine: "podman" or "docker"
# - For single-container: defaults to "podman" (more secure, rootless)
# - For compose: automatically uses "docker" (ENGINE setting is ignored)
#
# Examples:
#   ENGINE="podman"  # Use Podman for single-container (default)
#   ENGINE="docker"  # Use Docker for single-container
#
# Note: If docker-compose.yml exists in target, Docker is used automatically
ENGINE="podman"

# ============================================================================
# ZERO-DOWNTIME DEPLOYMENT (Optional)
# ============================================================================
# Enable Caddy-based zero-downtime deployment (blue-green strategy)
# Default: "false" (standard deployment with brief downtime)
#
# When enabled:
#   - Requires single-container mode (not compose)
#   - Requires Caddy to be set up first: ./setup-caddy.sh <target>
#   - Requires DOMAIN, APP_PORT, HEALTH_CHECK_PATH, HEALTH_CHECK_TIMEOUT settings
#   - Uses blue-green deployment with health checks
#   - Zero downtime during deployments
#
# Set to "true" for:
#   - Production environments requiring zero downtime
#   - Customer-facing applications with SLA requirements
#   - Deployments that need health check validation
#
# Examples:
#   USE_CADDY="false"  # Standard deployment (default, brief downtime)
#   USE_CADDY="true"   # Zero-downtime deployment via Caddy
USE_CADDY="false"

# ============================================================================
# SINGLE-CONTAINER CONFIGURATION
# (Required for single-container deployments, ignored for compose)
# ============================================================================

# Container image to deploy (without tag - tag specified at runtime)
# Example: "ghcr.io/your-org/your-image"
CONTAINER_IMAGE="ghcr.io/your-org/your-image"

# Container name (defaults to target directory name if not specified)
CONTAINER_NAME=""

# Port mappings (format: host:container, comma-separated for multiple ports)
# Example: "80:3000,443:3001"
PORT_MAPPINGS=""

# File mappings (format: local_file:container_path, comma-separated)
# Paths are relative to target directory
# Example: "config.json:/app/config.json,data.db:/app/data/data.db"
FILE_MAPPINGS=""

# ============================================================================
# REGISTRY AUTHENTICATION
# (Optional for both single-container and compose)
# ============================================================================

# GitHub Container Registry credentials (leave empty for public images)
# For private images, create a Personal Access Token with package:read permission
GHCR_USERNAME=""
GHCR_TOKEN=""

# ============================================================================
# SSH CONNECTION
# (Required for all deployment types)
# ============================================================================

# SSH host to deploy to (can be hostname from ~/.ssh/config or user@host)
# Example: "prod-server" or "deploy@example.com"
SSH_HOST="your-hostname"

# ============================================================================
# ZERO-DOWNTIME DEPLOYMENT (deploy-with-caddy.sh)
# (Only for single-container deployments)
# ============================================================================

# Domain name for Caddy automatic HTTPS
# Example: "example.com" or "api.example.com"
DOMAIN=""

# Application internal port (Caddy proxies to this)
APP_PORT="3000"

# Health check configuration
HEALTH_CHECK_PATH="/"
HEALTH_CHECK_TIMEOUT="30"

# ============================================================================
# DEPLOYMENT MODE SUMMARY
# ============================================================================
#
# SINGLE-CONTAINER (Podman or Docker):
#   Required: SSH_HOST, CONTAINER_IMAGE, ENGINE (optional, defaults to podman)
#   Optional: GHCR_USERNAME/TOKEN, CONTAINER_NAME, PORT_MAPPINGS, FILE_MAPPINGS
#   Files: .config, .env, (optional: additional files referenced in FILE_MAPPINGS)
#
# MULTI-CONTAINER (Docker Compose):
#   Required: SSH_HOST
#   Optional: GHCR_USERNAME/TOKEN (for private images)
#   Ignored: ENGINE (always uses docker), CONTAINER_IMAGE, PORT_MAPPINGS, FILE_MAPPINGS
#   Files: .config, .env, docker-compose.yml (or compose.yml)
#
# ZERO-DOWNTIME (Caddy + Blue-Green):
#   Same as single-container, plus: DOMAIN, APP_PORT, HEALTH_CHECK_PATH, HEALTH_CHECK_TIMEOUT
#   Note: Only supports single-container deployments
#
# ============================================================================
